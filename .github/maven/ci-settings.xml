<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for the CI jobs (copied to ~/.m2/settings.xml after setup-java).

  Maven Central occasionally answers 404 for artifacts that exist, which fails a whole run
  with "Could not find artifact ... (absent)". Maven looks up an artifact in each declared
  repository in turn until one delivers it, so a second copy of Maven Central makes such a
  miss harmless. Repositories from settings come before Central, so Google's mirror is asked
  first; whatever it lacks (it can lag behind Central briefly) still comes from Central.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <profiles>
    <profile>
      <id>central-fallback</id>
      <repositories>
        <repository>
          <id>central-mirror-google</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central-mirror-google</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>central-fallback</activeProfile>
  </activeProfiles>
</settings>
