<#if eventSource == "QUEUE">
<#assign fn = handlerInfo.functionId?lower_case?replace("[^a-z0-9-]", "-", "r")>
# Generated by Cloudhopper (knative): @EventTrigger(QUEUE "${eventName}") of the function "${handlerInfo.functionId}"; do not edit.
{{- $name := printf "%s-${fn}" .Release.Name | trunc 59 | trimSuffix "-" }}
{{- if not .Values.kafka.bootstrapServers }}
{{- fail "kafka.bootstrapServers is required: the function ${handlerInfo.functionId} reads the Kafka topic ${eventName}" }}
{{- end }}
{{- $servers := .Values.kafka.bootstrapServers }}
apiVersion: sources.knative.dev/v1beta1
kind: KafkaSource
metadata:
  name: {{ $name }}
  labels:
    app.kubernetes.io/instance: {{ .Release.Name }}
    app.kubernetes.io/managed-by: {{ .Release.Service }}
spec:
  bootstrapServers:
    {{- toYaml $servers | nindent 4 }}
  topics:
  - "${eventName?j_string}"
  consumerGroup: {{ .Values.kafka.consumerGroupPrefix }}${fn}
  delivery:
    retry: {{ .Values.delivery.retry }}
    backoffPolicy: {{ .Values.delivery.backoffPolicy }}
    backoffDelay: {{ .Values.delivery.backoffDelay }}
    {{- if .Values.delivery.deadLetterTopic }}
    deadLetterSink:
      ref:
        apiVersion: eventing.knative.dev/v1alpha1
        kind: KafkaSink
        name: {{ $name }}-dlt
    {{- end }}
  sink:
    ref:
      apiVersion: serving.knative.dev/v1
      kind: Service
      name: {{ .Release.Name }}
    uri: /events/${handlerInfo.functionId}
{{- if .Values.delivery.deadLetterTopic }}
---
apiVersion: eventing.knative.dev/v1alpha1
kind: KafkaSink
metadata:
  name: {{ $name }}-dlt
  labels:
    app.kubernetes.io/instance: {{ .Release.Name }}
    app.kubernetes.io/managed-by: {{ .Release.Service }}
spec:
  topic: "${eventName?j_string}.DLT"
  bootstrapServers:
    {{- toYaml $servers | nindent 4 }}
  {{- with .Values.delivery.deadLetterTopicPartitions }}
  numPartitions: {{ . }}
  {{- end }}
  {{- with .Values.delivery.deadLetterTopicReplicationFactor }}
  replicationFactor: {{ . }}
  {{- end }}
{{- end }}
<#else>
<#-- ${eventSource} events: no Knative source is generated; deliver them as CloudEvents to POST /events/${handlerInfo.functionId} -->
</#if>
