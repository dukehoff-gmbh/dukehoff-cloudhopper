# Generated by Cloudhopper (knative) for ${handlerInfo.artifactId}; do not edit.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: {{ .Release.Name }}
  labels:
    app.kubernetes.io/name: {{ .Chart.Name }}
    app.kubernetes.io/instance: {{ .Release.Name }}
    app.kubernetes.io/managed-by: {{ .Release.Service }}
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/min-scale: {{ .Values.scaling.minScale | quote }}
        autoscaling.knative.dev/max-scale: {{ .Values.scaling.maxScale | quote }}
    spec:
      timeoutSeconds: {{ .Values.timeoutSeconds }}
      containers:
      - image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
        imagePullPolicy: {{ .Values.image.pullPolicy }}
        # the PingSources trigger the schedules; an in-process schedule would fire in every replica
        args: ["--cloudhopper.schedules.in-process=false"]
        ports:
        - containerPort: 8080
        {{- with .Values.env }}
        env:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- with .Values.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
