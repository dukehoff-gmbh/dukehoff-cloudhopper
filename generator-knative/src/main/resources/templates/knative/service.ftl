<#-- one Knative service per deployment unit (FINALIZE: all units are known) -->
# Generated by Cloudhopper (knative); do not edit.
# One Knative service with a service account of its own per identity (@Function(identity)): a
# function runs only in the service of its identity, with that identity's permissions. The
# functions without an identity run in the service named like the release.
<#list units as u>
<#assign suffix = u?has_content?then("-" + u, "")>
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ printf "%s${suffix}" .Release.Name | trunc 63 | trimSuffix "-" }}
  labels:
    app.kubernetes.io/instance: {{ .Release.Name }}
    app.kubernetes.io/managed-by: {{ .Release.Service }}
    cloudhopper.eu/identity: "${u}"
---
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: {{ printf "%s${suffix}" .Release.Name | trunc 63 | trimSuffix "-" }}
  labels:
    cloudhopper.eu/identity: "${u}"
    app.kubernetes.io/name: {{ .Chart.Name }}
    app.kubernetes.io/instance: {{ .Release.Name }}
    app.kubernetes.io/managed-by: {{ .Release.Service }}
spec:
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ .Release.Name }}
      annotations:
        autoscaling.knative.dev/min-scale: {{ .Values.scaling.minScale | quote }}
        autoscaling.knative.dev/max-scale: {{ .Values.scaling.maxScale | quote }}
    spec:
      serviceAccountName: {{ printf "%s${suffix}" .Release.Name | trunc 63 | trimSuffix "-" }}
      timeoutSeconds: {{ .Values.timeoutSeconds }}
      containers:
      - image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
        imagePullPolicy: {{ .Values.image.pullPolicy }}
        args:
        # the PingSources trigger the schedules; an in-process schedule would fire in every replica
        - --cloudhopper.schedules.in-process=false
        {{- with .Values.kafka.bootstrapServers }}
        # @Queue publishers send to the Kafka topics; the KafkaSources deliver them
        - --cloudhopper.publisher=kafka
        - --spring.kafka.bootstrap-servers={{ join "," . }}
        {{- end }}
        ports:
        - containerPort: 8080
        env:
          # the identity this service runs: it answers only the endpoints of its functions
          - name: CLOUDHOPPER_IDENTITY
            value: "${u}"
          {{- with .Values.env }}
          {{- toYaml . | nindent 10 }}
          {{- end }}
          {{- with .Values.blobstore.s3Endpoint }}
          # the object storage of the @Bucket parameters
          - name: CLOUDHOPPER_BLOBSTORE_S3_ENDPOINT
            value: {{ . | quote }}
          {{- end }}
          {{- with .Values.blobstore.region }}
          - name: CLOUDHOPPER_BLOBSTORE_S3_REGION
            value: {{ . | quote }}
          {{- end }}
          {{- with .Values.blobstore.credentialsSecret }}
          - name: CLOUDHOPPER_BLOBSTORE_S3_ACCESS_KEY_ID
            valueFrom:
              secretKeyRef:
                name: {{ . }}
                key: access-key-id
          - name: CLOUDHOPPER_BLOBSTORE_S3_SECRET_ACCESS_KEY
            valueFrom:
              secretKeyRef:
                name: {{ . }}
                key: secret-access-key
          {{- end }}
          {{- range $name, $bucket := .Values.blobstore.buckets }}
          # @Bucket(name = "{{ $name }}")
          - name: {{ regexReplaceAll "[^A-Za-z0-9]" (printf "cloudhopper.bucket.%s.name" $name) "_" | upper }}
            value: {{ $bucket | quote }}
          {{- end }}
          {{- with .Values.keyvalue.jdbcUrl }}
          # the database of the @Table parameters
          - name: CLOUDHOPPER_KEYVALUE_JDBC_URL
            value: {{ . | quote }}
          {{- end }}
          {{- with .Values.keyvalue.credentialsSecret }}
          - name: CLOUDHOPPER_KEYVALUE_JDBC_USERNAME
            valueFrom:
              secretKeyRef:
                name: {{ . }}
                key: username
          - name: CLOUDHOPPER_KEYVALUE_JDBC_PASSWORD
            valueFrom:
              secretKeyRef:
                name: {{ . }}
                key: password
          {{- end }}
          {{- range $name, $table := .Values.keyvalue.tables }}
          # @Table(name = "{{ $name }}")
          - name: {{ regexReplaceAll "[^A-Za-z0-9]" (printf "cloudhopper.table.%s.name" $name) "_" | upper }}
            value: {{ $table | quote }}
          {{- end }}
          {{- range .Values.secrets }}
          # @ConfigProperty "{{ .property }}" from the Kubernetes secret {{ .secret }}
          - name: {{ regexReplaceAll "[^A-Za-z0-9]" .property "_" | upper }}
            valueFrom:
              secretKeyRef:
                name: {{ .secret }}
                key: {{ .key }}
          {{- end }}
        {{- with .Values.resources }}
        resources:
          {{- toYaml . | nindent 10 }}
        {{- end }}
</#list>
