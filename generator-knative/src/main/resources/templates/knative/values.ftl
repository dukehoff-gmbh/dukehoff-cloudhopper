# Generated by Cloudhopper (knative) for ${handlerInfo.artifactId} ${handlerInfo.version}.
# Override per cluster: helm upgrade --install <release> <chart> --set image.repository=...

image:
  # the image built from the generated Dockerfile (target/deployment/knative/shared-resources_dockerfile..dockerfile)
  repository: ${handlerInfo.artifactId?lower_case}
  tag: "${handlerInfo.version}"
  pullPolicy: IfNotPresent

kafka:
  # required when a function has @EventTrigger(source = QUEUE) or sends with @Queue; e.g. ["my-kafka.kafka.svc:9092"]
  bootstrapServers: []
  # consumer group per function: <consumerGroupPrefix><function>
  consumerGroupPrefix: cloudhopper-

# Delivery of queue messages: at least once, retried, then moved to a dead-letter topic
delivery:
  retry: 4
  backoffPolicy: exponential
  backoffDelay: PT1S
  # failed messages go to the topic <topic>.DLT through a KafkaSink (Knative Kafka sink required)
  deadLetterTopic: true
  # partitions and replication factor of a dead-letter topic the KafkaSink creates; empty: the sink's defaults
  deadLetterTopicPartitions: ""
  deadLetterTopicReplicationFactor: ""

scaling:
  # 0 scales to zero when idle; schedules and queues still reach the service through the sources
  minScale: 0
  # 0: no limit
  maxScale: 0

# request timeout of the service in seconds
timeoutSeconds: 300

# Object storage of the @Bucket parameters, through the S3 API: an S3-compatible storage such as
# MinIO or a cloud's object storage, or S3 itself. The chart creates no buckets; they must exist.
blobstore:
  # e.g. http://minio.minio.svc:9000; empty: S3 of the region
  s3Endpoint: ""
  # the signing region, e.g. us-east-1 for MinIO; required when a function has a @Bucket parameter
  region: ""
  # Kubernetes secret in the release's namespace with the keys access-key-id and secret-access-key
  credentialsSecret: ""
  # deployed bucket names by @Bucket name where they differ, e.g. {reports: prod-reports}
  buckets: {}

# PostgreSQL database of the @Table parameters, through JDBC. The application creates the tables
# it uses (unless @Table(existing = true)), so the user needs the right to create tables.
keyvalue:
  # e.g. jdbc:postgresql://postgres.db.svc:5432/app; required when a function has a @Table parameter
  jdbcUrl: ""
  # Kubernetes secret in the release's namespace with the keys username and password
  credentialsSecret: ""
  # deployed table names by @Table name where they differ, e.g. {accounts: prod_accounts}
  tables: {}

# container resources, e.g. {limits: {memory: 512Mi}}
resources: {}

# additional environment variables, e.g. [{name: SPRING_PROFILES_ACTIVE, value: prod}]
env: []

# configuration properties (@ConfigProperty) read from Kubernetes secrets in the release's
# namespace; the value is not part of the chart, e.g.
#   - property: report.api-key
#     secret: report
#     key: api-key
secrets: []
