# Generated by Cloudhopper (knative) for ${handlerInfo.artifactId} ${handlerInfo.version}.
# Override per cluster: helm upgrade --install <release> <chart> --set image.repository=...

image:
  # the image built from the generated Dockerfile (target/deployment/knative/shared-resources_dockerfile..dockerfile)
  repository: ${handlerInfo.artifactId?lower_case}
  tag: "${handlerInfo.version}"
  pullPolicy: IfNotPresent

kafka:
  # required when a function has @EventTrigger(source = QUEUE); e.g. ["my-kafka.kafka.svc:9092"]
  bootstrapServers: []
  # consumer group per function: <consumerGroupPrefix><function>
  consumerGroupPrefix: cloudhopper-

# Delivery of queue messages: at least once, retried, then moved to a dead-letter topic
delivery:
  retry: 4
  backoffPolicy: exponential
  backoffDelay: PT1S
  # failed messages go to the topic <topic>.DLT through a KafkaSink (Knative Kafka sink required)
  deadLetterTopic: true
  # partitions and replication factor of a dead-letter topic the KafkaSink creates; empty: the sink's defaults
  deadLetterTopicPartitions: ""
  deadLetterTopicReplicationFactor: ""

scaling:
  # 0 scales to zero when idle; schedules and queues still reach the service through the sources
  minScale: 0
  # 0: no limit
  maxScale: 0

# request timeout of the service in seconds
timeoutSeconds: 300

# container resources, e.g. {limits: {memory: 512Mi}}
resources: {}

# additional environment variables, e.g. [{name: SPRING_PROFILES_ACTIVE, value: prod}]
env: []
