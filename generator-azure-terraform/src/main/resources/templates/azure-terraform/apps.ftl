# Generated by Cloudhopper (azure-terraform); do not edit.
# One function app per identity (@Function(identity)), each with a managed identity of its own;
# all run the same package, and each runs only the functions of its identity. The functions
# without an identity run in the app "my-shared-function-app".
locals {
  cloudhopper_units = [<#list units as u>"${u}"<#sep>, </#sep></#list>]
  # the Azure functions of each unit: per function the HTTP, API, event and schedule entry points
  # (the host ignores the names of entry points a function does not have)
  cloudhopper_unit_functions = {
<#list units as u>
    "${u}" = [<#list functionUnits as fn, fu><#if fu == u>"${fn}", "${fn}_api", "${fn}_event", "${fn}_scheduled"<#sep>, </#sep></#if></#list>]
</#list>
  }
}

resource "azurerm_linux_function_app" "shared_function_app" {
  for_each            = toset(local.cloudhopper_units)
  name                = each.key == "" ? "my-shared-function-app" : "my-shared-function-app-${"$"}{each.key}"
  resource_group_name = azurerm_resource_group.function_rg.name
  location            = azurerm_resource_group.function_rg.location
  
  service_plan_id            = azurerm_service_plan.function_plan.id
  storage_account_name       = azurerm_storage_account.function_storage.name
  storage_account_access_key = azurerm_storage_account.function_storage.primary_access_key

  site_config {
    application_stack {
      java_version = "21" 
    }
  }

  # the identity the functions read their secrets with
  identity {
    type = "SystemAssigned"
  }

  # the app gets all configuration properties; it runs only the functions of its identity
  app_settings = merge({
    FUNCTIONS_WORKER_RUNTIME    = "java"
    AzureWebJobsDisableHomepage = "true"
    WEBSITE_RUN_FROM_PACKAGE    = "${"$"}{azurerm_storage_blob.function_code.url}?${"$"}{trim(data.azurerm_storage_account_blob_container_sas.function_zip_sas.sas, "?")}"
    
    # Enable Application Logging (Filesystem)
    "AzureWebJobsDashboard"           = "true" # Not strictly required anymore, but harmless
    "WEBSITE_ENABLE_APP_SERVICE_STORAGE" = "true"

    # Set the logging level
    "FUNCTIONS_EXTENSION_VERSION"    = "~4"    # You're already using this
    "FUNCTIONS_LOGGING_CONSOLE_LEVEL" = "Information"  # or "Verbose" for even more

    APPLICATIONINSIGHTS_CONNECTION_STRING = azurerm_application_insights.function_app_insights.connection_string
    APPLICATIONINSIGHTS_ROLE_NAME         = each.key == "" ? "my-shared-function-app" : "my-shared-function-app-${"$"}{each.key}"
  }, {
    # the functions of this app's identity (host.json "functions"): all apps run the same package
    for index, name in local.cloudhopper_unit_functions[each.key] : "AzureFunctionsJobHost__functions__${"$"}{index}" => name
  }, each.key == "" ? {} : {
    # the apps share the storage account; the host ID would otherwise be the first 32 characters
    # of the app name, which can be the same for two apps
    AzureFunctionsWebHost__hostid = substr(sha1("my-shared-function-app-${"$"}{each.key}"), 0, 32)
  }, { for name, value in local.cloudhopper_config : upper(replace(name, "/[^A-Za-z0-9]/", "_")) => value },
  length(local.cloudhopper_secrets) == 0 ? {} : {
    # the URIs of the secrets, read by the runtime from Key Vault
    CLOUDHOPPER_SECRETS = jsonencode({ for name, id in local.cloudhopper_secrets :
      name => "https://${"$"}{split("/", id)[8]}.vault.azure.net/secrets/${"$"}{split("/", id)[10]}" })
  })

  lifecycle {
    precondition {
      condition     = length(local.cloudhopper_duplicate_properties) == 0
      error_message = "Properties are set more than once in cloudhopper_config, cloudhopper_secrets, cloudhopper_extra_config and cloudhopper_extra_secrets: ${"$"}{join(", ", local.cloudhopper_duplicate_properties)}"
    }
  }

  depends_on = [azurerm_storage_blob.function_code]
}

# Read access of each function app to the secrets
resource "azurerm_role_assignment" "cloudhopper_secret" {
  for_each             = { for pair in setproduct(local.cloudhopper_units, keys(local.cloudhopper_secrets)) : "${"$"}{pair[0]}/${"$"}{pair[1]}" => { unit = pair[0], id = local.cloudhopper_secrets[pair[1]] } }
  scope                = each.value.id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = azurerm_linux_function_app.shared_function_app[each.value.unit].identity[0].principal_id
}

# deployments made before the apps per identity keep their app as the default unit
moved {
  from = azurerm_linux_function_app.shared_function_app
  to   = azurerm_linux_function_app.shared_function_app[""]
}

output "function_app_principal_id" {
  description = "Object ID of the managed identity of the app of the functions without an identity"
  value       = try(azurerm_linux_function_app.shared_function_app[""].identity[0].principal_id, null)
}

output "function_app_principal_ids" {
  description = "Object ID of each identity's app's managed identity, e.g. to grant it further access; \"\" for the functions without one"
  value       = { for unit, app in azurerm_linux_function_app.shared_function_app : unit => app.identity[0].principal_id }
}

output "function_app_hostnames" {
  value = { for unit, app in azurerm_linux_function_app.shared_function_app : unit => app.default_hostname }
}


