# Generated by Cloudhopper (scaleway-terraform); do not edit.
# The settings of the @Queue publishers, which send through the SQS API of Scaleway Queues.
<#if publishedQueues?has_content>
resource "scaleway_mnq_sqs_credentials" "cloudhopper_publisher" {
  project_id = scaleway_mnq_sqs.cloudhopper.project_id
  name       = "${"$"}{var.container_name}-publisher"

  permissions {
    can_manage  = false
    can_receive = false
    can_publish = true
  }
}

locals {
  cloudhopper_publisher_environment = {
    AWS_REGION = scaleway_mnq_sqs.cloudhopper.region
<#list publishedQueues as q>
<#if queueConsumers[q.name]??>
<#assign fid = queueConsumers[q.name]?lower_case?replace("[^a-z0-9_]", "_", "r")>
    # @Queue(name = "${q.name}"): the queue of the function ${queueConsumers[q.name]}
    ${q.urlEnvironmentName} = scaleway_mnq_sqs_queue.${fid}_queue.url
<#else>
    # @Queue(name = "${q.name}"): no function of the project consumes it; set ${q.urlEnvironmentName}
</#if>
</#list>
  }
  cloudhopper_publisher_secrets = {
    AWS_ACCESS_KEY_ID     = scaleway_mnq_sqs_credentials.cloudhopper_publisher.access_key
    AWS_SECRET_ACCESS_KEY = scaleway_mnq_sqs_credentials.cloudhopper_publisher.secret_key
  }
}
<#else>
locals {
  cloudhopper_publisher_environment = {}
  cloudhopper_publisher_secrets     = {}
}
</#if>
