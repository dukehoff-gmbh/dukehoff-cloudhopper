# Generated by Cloudhopper (scaleway-terraform); do not edit.
# The tables functions read and write (@Table): tables of one Scaleway Serverless SQL Database
# (PostgreSQL), and the container settings of the database.
<#if tables?has_content>
locals {
  # @Table names mapped to the names of the tables in the database where they differ, e.g.
  # { accounts = "prod_accounts" }; redefine this local in an override file
  # (cloudhopper_override.tf).
  cloudhopper_table_names = {}
  # The endpoint of a database your own Terraform creates, e.g.
  # scaleway_sdb_sql_database.app.endpoint; redefine this local in an override file. Empty: the
  # generated Terraform creates a database.
  cloudhopper_keyvalue_database_endpoint = ""
}

# The principal the container connects to the database as: the ID of an IAM application with
# the permission set ServerlessSQLDatabaseReadWrite in the project, and the secret key of one of
# its API keys. The generated Terraform creates no IAM resources. The values are stored in the
# Terraform state: keep it in a protected backend.
variable "cloudhopper_keyvalue_credentials" {
  description = "IAM application ID and secret key of the database user, for the @Table parameters"
  type = object({
    principal_id = string
    secret_key   = string
  })
  default   = null
  sensitive = true
}

# The database of the tables, unless cloudhopper_keyvalue_database_endpoint names one of your
# own. It scales to zero when idle. The application creates the tables it uses (unless
# @Table(existing = true)); destroying the deployment deletes the database and its items.
resource "scaleway_sdb_sql_database" "tables" {
  count  = local.cloudhopper_keyvalue_database_endpoint == "" ? 1 : 0
  name   = "${"$"}{var.cloudhopper_name_prefix}${"$"}{var.container_name}-tables"
  region = scaleway_container_namespace.app.region
}
<#list tables as t>

# @Table(name = "${t.name}"<#if t.existing>, existing = true</#if>)
locals {
  cloudhopper_table_${t.id} = lookup(local.cloudhopper_table_names, "${t.name}", "${t.name}")
}

output "table_${t.id}" {
  value = local.cloudhopper_table_${t.id}
}
</#list>

locals {
  cloudhopper_keyvalue_endpoint = local.cloudhopper_keyvalue_database_endpoint != "" ? local.cloudhopper_keyvalue_database_endpoint : one(scaleway_sdb_sql_database.tables[*].endpoint)
  cloudhopper_keyvalue_environment = {
    # the endpoint is postgres://<host>:<port>/<database>?sslmode=require
    CLOUDHOPPER_KEYVALUE_JDBC_URL = "jdbc:postgresql://${"$"}{trimprefix(trimprefix(local.cloudhopper_keyvalue_endpoint, "postgres://"), "postgresql://")}"
<#list tables as t>
    ${t.nameEnvironmentName} = local.cloudhopper_table_${t.id}
</#list>
  }
  cloudhopper_keyvalue_secrets = var.cloudhopper_keyvalue_credentials == null ? {} : {
    CLOUDHOPPER_KEYVALUE_JDBC_USERNAME = var.cloudhopper_keyvalue_credentials.principal_id
    CLOUDHOPPER_KEYVALUE_JDBC_PASSWORD = var.cloudhopper_keyvalue_credentials.secret_key
  }
  cloudhopper_keyvalue_credentials_missing = var.cloudhopper_keyvalue_credentials == null
}
<#else>
locals {
  cloudhopper_keyvalue_environment         = {}
  cloudhopper_keyvalue_secrets             = {}
  cloudhopper_keyvalue_credentials_missing = false
}
</#if>
