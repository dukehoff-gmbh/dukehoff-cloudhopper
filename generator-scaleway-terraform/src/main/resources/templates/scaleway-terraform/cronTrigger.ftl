<#assign fid = handlerInfo.functionId?lower_case?replace("[^a-z0-9_]", "_", "r")>
<#assign fn = handlerInfo.functionId?lower_case?replace("[^a-z0-9-]", "-", "r")>
# Generated by Cloudhopper (scaleway-terraform): @ScheduledTrigger of the function "${handlerInfo.functionId}"; do not edit.
resource "scaleway_container_trigger" "${fid}_schedule" {
  # the container of the function's identity
  container_id = scaleway_container.app["${unit}"].id
  name         = "${fn}-schedule"

  cron {
    schedule = "${scheduleExpression?trim?j_string}"
    timezone = "${scheduleTimezone?j_string}"
  }

  destination_config {
    http_path   = "/schedules/${handlerInfo.functionId}"
    http_method = "post"
  }
}

output "${fid}_schedule_timezone" {
  value = scaleway_container_trigger.${fid}_schedule.cron[0].timezone
}
