<#-- container and namespace names: lowercase letters, digits and hyphens -->
<#assign defaultName = handlerInfo.artifactId?lower_case?replace("[^a-z0-9-]", "-", "r")?replace("-+", "-", "r")?remove_beginning("-")>
<#if defaultName?length gt 34><#assign defaultName = defaultName?substring(0, 34)?remove_ending("-")></#if>
# Generated by Cloudhopper (scaleway-terraform) for ${handlerInfo.artifactId}; do not edit.
# One Serverless Container runs the application with all functions. The provider
# (region, project) and the backend belong in your own main.tf.
<#noparse>
terraform {
  required_version = ">= 1.5.0, < 2.0.0"
  required_providers {
    scaleway = {
      source  = "scaleway/scaleway"
      version = "~> 2.92"
    }
  }
}

variable "image" {
  description = "The application image, built from the generated Dockerfile for linux/amd64, e.g. rg.fr-par.scw.cloud/<namespace>/<app>:<tag>"
  type        = string
}
</#noparse>
variable "container_name" {
  description = "Name of the container namespace and the container"
  type        = string
  default     = "${defaultName}"
}
<#noparse>
variable "cloudhopper_name_prefix" {
  description = "Prefix for the names of the queues, e.g. to keep several deployments in one project apart"
  type        = string
  default     = ""
}

variable "min_scale" {
  description = "Minimum number of instances; 0 scales to zero when idle"
  type        = number
  default     = 0
}

variable "max_scale" {
  description = "Maximum number of instances"
  type        = number
  default     = 5
}

variable "memory_limit_bytes" {
  description = "Memory of an instance; Scaleway pairs it with cpu_limit (1 GiB goes with 560 mVCPU)"
  type        = number
  default     = 1073741824
}

variable "cpu_limit" {
  description = "CPU of an instance in mVCPU"
  type        = number
  default     = 560
}

variable "timeout" {
  description = "Maximum duration of a request in seconds"
  type        = number
  default     = 300
}

variable "privacy" {
  description = "public, or private to require a token for HTTP calls"
  type        = string
  default     = "public"
}

# Values of the configuration properties the functions read with @ConfigProperty, by property
# name, e.g. { "report.bucket" = "my-reports" }. The container runs all functions and gets all of them as environment variables
# (report.bucket → REPORT_BUCKET).
variable "cloudhopper_config" {
  description = "Values of the functions' configuration properties (@ConfigProperty), by property name"
  type        = map(string)
  default     = {}
}

# Secrets the functions read with @ConfigProperty, by property name, e.g.
# { "report.api-key" = "..." }. The container gets them as secret environment variables
# (report.api-key → REPORT_API_KEY). The values are stored in the Terraform state: keep it
# in a protected backend.
variable "cloudhopper_secrets" {
  description = "Values of the functions' secret configuration properties (@ConfigProperty), by property name"
  type        = map(string)
  default     = {}
  sensitive   = true
}

# Values from the project's own Terraform. The generated files and your own .tf files form one
# module, and a variable cannot refer to its resources or data sources. To pass such values,
# redefine these locals in an override file (override.tf or <name>_override.tf next to main.tf):
#   locals {
#     cloudhopper_extra_config  = { "auth.client-id" = <resource>.<name>.<attribute> }
#     cloudhopper_extra_secrets = { "report.api-key" = <reference to a secret> }
#   }
# A property may be set only once in cloudhopper_config, cloudhopper_secrets and these locals.
locals {
  cloudhopper_extra_config  = {}
  cloudhopper_extra_secrets = {}

  # what the functions get
  cloudhopper_config  = merge(var.cloudhopper_config, local.cloudhopper_extra_config)
  cloudhopper_secrets = merge(var.cloudhopper_secrets, local.cloudhopper_extra_secrets)
  # properties set more than once, checked by a precondition
  cloudhopper_duplicate_properties = sort(setunion(
    setintersection(keys(var.cloudhopper_config), keys(local.cloudhopper_extra_config)),
    setintersection(nonsensitive(keys(var.cloudhopper_secrets)), keys(local.cloudhopper_extra_secrets)),
    setintersection(keys(local.cloudhopper_config), nonsensitive(keys(local.cloudhopper_secrets)))))
}

variable "environment_variables" {
  description = "Environment variables of the application"
  type        = map(string)
  default     = {}
}

variable "secret_environment_variables" {
  description = "Secret environment variables of the application"
  type        = map(string)
  default     = {}
  sensitive   = true
}

variable "queue_max_receive_count" {
  description = "Receives of a queue message before it moves to the dead-letter queue; the trigger calls the function up to 4 times per receive"
  type        = number
  default     = 1
}

variable "queue_visibility_timeout_seconds" {
  description = "Visibility timeout of the queues in seconds"
  type        = number
  default     = 30
}

resource "scaleway_container_namespace" "app" {
  name = var.container_name
}

# One container per identity (@Function(identity)), all from the same image: a container
# answers only the endpoints of the functions of its identity (CLOUDHOPPER_IDENTITY). The
# functions without an identity run in the container named container_name ("" in
# local.cloudhopper_units, see units.tf); the others in container_name-<identity>.
resource "scaleway_container" "app" {
  for_each                     = toset(local.cloudhopper_units)
  name                         = each.key == "" ? var.container_name : "${var.container_name}-${each.key}"
  namespace_id                 = scaleway_container_namespace.app.id
  image                        = var.image
  port                         = 8080
  min_scale                    = var.min_scale
  max_scale                    = var.max_scale
  memory_limit_bytes           = var.memory_limit_bytes
  cpu_limit                    = var.cpu_limit
  timeout                      = var.timeout
  privacy                      = var.privacy
  environment_variables        = merge({ for name, value in local.cloudhopper_config : upper(replace(name, "/[^A-Za-z0-9]/", "_")) => value }, local.cloudhopper_publisher_environment, local.cloudhopper_blobstore_environment, local.cloudhopper_keyvalue_environment, var.environment_variables, { CLOUDHOPPER_IDENTITY = each.key })
  secret_environment_variables = merge(local.cloudhopper_publisher_secrets, local.cloudhopper_blobstore_secrets, local.cloudhopper_keyvalue_secrets, { for name, value in local.cloudhopper_secrets : upper(replace(name, "/[^A-Za-z0-9]/", "_")) => value }, var.secret_environment_variables)
  # the cron triggers call the schedules; an in-process schedule would run in every instance
  args = ["--cloudhopper.schedules.in-process=false"]

  lifecycle {
    precondition {
      condition     = length(local.cloudhopper_duplicate_properties) == 0
      error_message = "Properties are set more than once in cloudhopper_config, cloudhopper_secrets, cloudhopper_extra_config and cloudhopper_extra_secrets: ${join(", ", local.cloudhopper_duplicate_properties)}"
    }
    precondition {
      condition     = !local.cloudhopper_blobstore_credentials_missing
      error_message = "The functions use buckets (@Bucket): set cloudhopper_blobstore_credentials to a key of the object storage"
    }
    precondition {
      condition     = !local.cloudhopper_keyvalue_credentials_missing
      error_message = "The functions use tables (@Table): set cloudhopper_keyvalue_credentials to an IAM application and its secret key"
    }
  }
}

# deployments made before the containers per identity keep their container as the default unit
moved {
  from = scaleway_container.app
  to   = scaleway_container.app[""]
}

output "url" {
  description = "Base URL of the container of the functions without an identity"
  value       = try(scaleway_container.app[""].public_endpoint, null)
}

output "urls" {
  description = "Base URL of each identity's container; \"\" for the functions without an identity"
  value       = { for unit, container in scaleway_container.app : unit => container.public_endpoint }
}

output "container_id" {
  value = try(scaleway_container.app[""].id, null)
}

output "container_ids" {
  value = { for unit, container in scaleway_container.app : unit => container.id }
}
</#noparse>
