<#if eventSource == "QUEUE">
<#assign fid = handlerInfo.functionId?lower_case?replace("[^a-z0-9_]", "_", "r")>
<#assign fn = handlerInfo.functionId?lower_case?replace("[^a-z0-9-]", "-", "r")>
<#assign queue = eventName?j_string>
# Generated by Cloudhopper (scaleway-terraform): @EventTrigger(QUEUE "${eventName}") of the function "${handlerInfo.functionId}"; do not edit.
resource "scaleway_mnq_sqs_queue" "${fid}_dlq" {
  name         = "${"$"}{var.cloudhopper_name_prefix}${queue}-dlq"
  sqs_endpoint = scaleway_mnq_sqs.cloudhopper.endpoint
  access_key   = scaleway_mnq_sqs_credentials.cloudhopper.access_key
  secret_key   = scaleway_mnq_sqs_credentials.cloudhopper.secret_key
}

resource "scaleway_mnq_sqs_queue" "${fid}_queue" {
  name                       = "${"$"}{var.cloudhopper_name_prefix}${queue}"
  sqs_endpoint               = scaleway_mnq_sqs.cloudhopper.endpoint
  access_key                 = scaleway_mnq_sqs_credentials.cloudhopper.access_key
  secret_key                 = scaleway_mnq_sqs_credentials.cloudhopper.secret_key
  visibility_timeout_seconds = var.queue_visibility_timeout_seconds

  # the trigger calls the function up to 4 times per receive; after max_receive_count
  # receives the message moves to the dead-letter queue
  dead_letter_queue {
    id                = scaleway_mnq_sqs_queue.${fid}_dlq.id
    max_receive_count = var.queue_max_receive_count
  }
}

resource "scaleway_container_trigger" "${fid}_queue" {
  container_id = scaleway_container.app.id
  name         = "${fn}-queue"

  sqs {
    endpoint   = scaleway_mnq_sqs.cloudhopper.endpoint
    queue_url  = scaleway_mnq_sqs_queue.${fid}_queue.url
    access_key = scaleway_mnq_sqs_credentials.cloudhopper.access_key
    secret_key = scaleway_mnq_sqs_credentials.cloudhopper.secret_key
  }

  destination_config {
    http_path   = "/events/${handlerInfo.functionId}"
    http_method = "post"
  }
}

output "${fid}_queue_url" {
  value = scaleway_mnq_sqs_queue.${fid}_queue.url
}

output "${fid}_dead_letter_queue_url" {
  value = scaleway_mnq_sqs_queue.${fid}_dlq.url
}
<#else>
# Generated by Cloudhopper (scaleway-terraform); do not edit.
# ${eventSource} "${eventName}" of the function "${handlerInfo.functionId}": Scaleway has no trigger for it.
# Deliver the events to POST /events/${handlerInfo.functionId} yourself.
</#if>
