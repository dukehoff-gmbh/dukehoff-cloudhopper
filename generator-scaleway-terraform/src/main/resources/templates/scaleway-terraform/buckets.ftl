# Generated by Cloudhopper (scaleway-terraform); do not edit.
# The buckets functions read and write (@Bucket), in Scaleway Object Storage, and the container
# settings of the object storage.
<#if buckets?has_content>
locals {
  # @Bucket names mapped to buckets your own Terraform creates, e.g.
  # { reports = scaleway_object_bucket.reports.name }; redefine this local in an override file
  # (cloudhopper_override.tf). The generated Terraform creates no bucket for these names.
  cloudhopper_bucket_names = {}
}

# The key the container signs its object storage requests with: an IAM API key, e.g. of an
# application with the permission set ObjectStorageReadOnly or ObjectStorageFullAccess in the
# project. The generated Terraform creates no IAM resources. The values are stored in the
# Terraform state: keep it in a protected backend.
variable "cloudhopper_blobstore_credentials" {
  description = "Access key and secret key of the object storage, for the @Bucket parameters"
  type = object({
    access_key = string
    secret_key = string
  })
  default   = null
  sensitive = true
}
<#list buckets as b>
<#assign id = b.id>

<#if b.existing>
# @Bucket(name = "${b.name}", existing = true): a bucket another system owns
locals {
  cloudhopper_bucket_${id} = "${b.name}"
}
<#else>
# @Bucket(name = "${b.name}"), unless cloudhopper_bucket_names names a bucket of your own. Bucket
# names are global within a region. Terraform does not delete a bucket that still contains
# objects.
resource "scaleway_object_bucket" "bucket_${id}" {
  count  = contains(keys(local.cloudhopper_bucket_names), "${b.name}") ? 0 : 1
  name   = "${"$"}{var.cloudhopper_name_prefix}${b.name}"
  region = scaleway_container_namespace.app.region
}

locals {
  cloudhopper_bucket_${id} = lookup(local.cloudhopper_bucket_names, "${b.name}", one(scaleway_object_bucket.bucket_${id}[*].name))
}
</#if>

output "bucket_${id}" {
  value = local.cloudhopper_bucket_${id}
}
</#list>

locals {
  cloudhopper_blobstore_environment = {
    CLOUDHOPPER_BLOBSTORE_S3_ENDPOINT = "https://s3.${"$"}{scaleway_container_namespace.app.region}.scw.cloud"
    CLOUDHOPPER_BLOBSTORE_S3_REGION   = scaleway_container_namespace.app.region
<#list buckets as b>
    ${b.nameEnvironmentName} = local.cloudhopper_bucket_${b.id}
</#list>
  }
  cloudhopper_blobstore_secrets = var.cloudhopper_blobstore_credentials == null ? {} : {
    CLOUDHOPPER_BLOBSTORE_S3_ACCESS_KEY_ID     = var.cloudhopper_blobstore_credentials.access_key
    CLOUDHOPPER_BLOBSTORE_S3_SECRET_ACCESS_KEY = var.cloudhopper_blobstore_credentials.secret_key
  }
  cloudhopper_blobstore_credentials_missing = var.cloudhopper_blobstore_credentials == null
}
<#else>
locals {
  cloudhopper_blobstore_environment         = {}
  cloudhopper_blobstore_secrets             = {}
  cloudhopper_blobstore_credentials_missing = false
}
</#if>
