# Generated by Cloudhopper (aws-terraform); do not edit.
# The buckets functions read and write (@Bucket), and the permissions of their identities.
locals {
  # @Bucket names mapped to buckets your own Terraform creates, e.g.
  # { reports = aws_s3_bucket.reports.bucket }; redefine this local in an override file
  # (cloudhopper_override.tf). The generated Terraform creates no bucket for these names.
  cloudhopper_bucket_names = {}
}
<#list buckets as b>
<#assign id = b.id>

<#if b.existing>
# @Bucket(name = "${b.name}", existing = true): a bucket another system owns
locals {
  cloudhopper_bucket_${id} = "${b.name}"
}
<#elseif storageBuckets[b.name]??>
<#assign fid = storageBuckets[b.name]>
# @Bucket(name = "${b.name}"): the bucket of the storage trigger of function ${fid}
locals {
  cloudhopper_bucket_${id} = <#if storageBucketCreated[b.name]>aws_s3_bucket<#else>data.aws_s3_bucket</#if>.${fid}_bucket.id
}
<#else>
# @Bucket(name = "${b.name}"), unless cloudhopper_bucket_names names a bucket of your own. S3
# bucket names are global across all AWS accounts. Terraform does not delete a bucket that still
# contains objects.
resource "aws_s3_bucket" "bucket_${id}" {
  count  = contains(keys(local.cloudhopper_bucket_names), "${b.name}") ? 0 : 1
  bucket = "${"$"}{var.cloudhopper_name_prefix}${b.name}"
}

locals {
  cloudhopper_bucket_${id} = lookup(local.cloudhopper_bucket_names, "${b.name}", one(aws_s3_bucket.bucket_${id}[*].bucket))
}
</#if>

output "bucket_${id}" {
  value = local.cloudhopper_bucket_${id}
}
<#list bucketAccess[b.name] as identity, access>

# ${access} access of identity "${identity}" to bucket "${b.name}"
resource "aws_iam_role_policy" "bucket_${id}_${identity}" {
  name = "bucket-${b.name}"
  role = aws_iam_role.identity_${identity}.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
<#if access != "WRITE">
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = "arn:aws:s3:::${"$"}{local.cloudhopper_bucket_${id}}"
      },
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject"]
        Resource = "arn:aws:s3:::${"$"}{local.cloudhopper_bucket_${id}}/*"
      }<#if access != "READ">,</#if>
</#if>
<#if access != "READ">
      {
        Effect   = "Allow"
        Action   = ["s3:PutObject", "s3:DeleteObject"]
        Resource = "arn:aws:s3:::${"$"}{local.cloudhopper_bucket_${id}}/*"
      }
</#if>
    ]
  })
}
</#list>
</#list>
