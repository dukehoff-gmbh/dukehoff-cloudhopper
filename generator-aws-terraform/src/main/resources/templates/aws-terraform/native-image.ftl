{
  "comment": "Generated by Cloudhopper for the function ${handlerInfo.functionId}: what a native image needs to create its handler (NativeRuntime reads the class from _HANDLER) and to bind its types with Jackson.",
  "reflection": [
    {
      "type": "${handlerWrapperFullyQualifiedName}$Auto",
      "methods": [{"name": "<init>", "parameterTypes": []}]
    }<#list handlerInfo.bindingTypes as type>,
    {
      "type": "${type}",
      "allDeclaredFields": true,
      "allDeclaredMethods": true,
      "allDeclaredConstructors": true
    },
    {
      "type": "${type}[]"
    }</#list>
  ]
}
