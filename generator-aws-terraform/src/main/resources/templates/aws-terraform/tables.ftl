# Generated by Cloudhopper (aws-terraform); do not edit.
# The DynamoDB tables functions read and write (@Table), and the permissions of their identities.
locals {
  # @Table names mapped to tables your own Terraform creates, e.g.
  # { accounts = aws_dynamodb_table.accounts.name }; redefine this local in an override file
  # (cloudhopper_override.tf). The generated Terraform creates no table for these names. A table
  # of your own needs the string partition key _pk and the string sort key _sk.
  cloudhopper_table_names = {}
}
<#list tables as t>
<#assign id = t.id>

<#if t.existing>
# @Table(name = "${t.name}", existing = true): a table another system owns, with the string
# partition key _pk and the string sort key _sk
locals {
  cloudhopper_table_${id} = "${t.name}"
}
<#else>
# @Table(name = "${t.name}"), unless cloudhopper_table_names names a table of your own. Destroying
# the deployment deletes the table and its items.
resource "aws_dynamodb_table" "table_${id}" {
  count        = contains(keys(local.cloudhopper_table_names), "${t.name}") ? 0 : 1
  name         = "${"$"}{var.cloudhopper_name_prefix}${t.name}"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "_pk"
  range_key    = "_sk"

  attribute {
    name = "_pk"
    type = "S"
  }

  attribute {
    name = "_sk"
    type = "S"
  }
}

locals {
  cloudhopper_table_${id} = lookup(local.cloudhopper_table_names, "${t.name}", one(aws_dynamodb_table.table_${id}[*].name))
}
</#if>

output "table_${id}" {
  value = local.cloudhopper_table_${id}
}
<#list tableAccess[t.name] as identity, access>

# ${access} access of identity "${identity}" to table "${t.name}"
resource "aws_iam_role_policy" "table_${id}_${identity}" {
  name = "table-${t.name}"
  role = aws_iam_role.identity_${identity}.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = [<#if access != "WRITE">"dynamodb:GetItem", "dynamodb:Query"</#if><#if access == "READ_WRITE">, </#if><#if access != "READ">"dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:BatchWriteItem"</#if>]
        Resource = "arn:aws:dynamodb:${"$"}{data.aws_region.cloudhopper.region}:${"$"}{data.aws_caller_identity.current.account_id}:table/${"$"}{local.cloudhopper_table_${id}}"
      }
    ]
  })
}
</#list>
</#list>
