<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>\${groupId}</groupId>
    <artifactId>\${artifactId}</artifactId>
    <version>\${version}</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cloudhopper.version>${project.version}</cloudhopper.version>
        <!-- jvm, or native with the profile aws-native -->
        <cloudhopper.runtime>jvm</cloudhopper.runtime>
        <!-- the architecture of a native image: arm64 or x86_64 -->
        <native.architecture>arm64</native.architecture>
#if($includeTerraformProfile == 'true')
        <!-- add the path to your terraform executable here -->
        <terraform.executable>terraform</terraform.executable>
        <terraform.command>plan</terraform.command>
        <path.extras></path.extras>
#end
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.cloudhopper.mc</groupId>
            <artifactId>deployment-config-api</artifactId>
            <version>\${cloudhopper.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.cloudhopper.mc</groupId>
            <artifactId>deployment-config-processor</artifactId>
            <version>\${cloudhopper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
            <version>2.1.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <!-- shows Cloudhopper's warnings about annotations a target does not support -->
                    <showWarnings>true</showWarnings>
                    <annotationProcessors>
                        <annotationProcessor>eu.cloudhopper.mc.deployment.config.generator.ServerlessFunctionProcessor</annotationProcessor>
                    </annotationProcessors>
                    <compilerArgs>
                        <arg>-AgeneratorId=\${generator.id}</arg>
                        <arg>-AconfigOutputDir=\${project.build.directory}/deployment/\${generator.id}</arg>
                        <arg>-AartifactId=\${project.artifactId}</arg>
                        <arg>-Aversion=\${project.version}</arg>
                        <arg>-Aclassifier=\${jar.classifier}</arg>
                        <arg>-AtargetDir=\${project.build.directory}</arg>
                        <arg>-Aruntime=\${cloudhopper.runtime}</arg>
                        <arg>-AnativeArchitecture=\${native.architecture}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
#foreach($generator in $generatorIds.split(","))
        <profile>
            <id>${generator}</id>
            <properties>
                <generator.id>${generator}</generator.id>
                <output.dir>target/generated-sources/${generator}</output.dir>
                <jar.classifier>${generator}</jar.classifier>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
## the generator id springboot-http is served by the artifact generator-springboot
#if($generator == "springboot-http")
                    <artifactId>generator-springboot</artifactId>
#else
                    <artifactId>generator-${generator}</artifactId>
#end
                    <version>${cloudhopper.version}</version>
                    <!-- only the annotation processor uses the generator; the runtime is the provider below -->
                    <scope>provided</scope>
                </dependency>
#if($generator == "aws-terraform" || $generator == "gcp-terraform" || $generator == "azure-terraform")
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-${generator.replace("-terraform", "")}</artifactId>
                    <version>${cloudhopper.version}</version>
                </dependency>
                <!-- sends messages to queues from function code (@Queue Publisher) -->
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-${generator.replace("-terraform", "")}-publisher</artifactId>
                    <version>${cloudhopper.version}</version>
                </dependency>
                <!-- reads and writes buckets from function code (@Bucket BlobStore) -->
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-${generator.replace("-terraform", "")}-blobstore</artifactId>
                    <version>${cloudhopper.version}</version>
                </dependency>
                <!-- reads and writes tables from function code (@Table KeyValueStore) -->
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-${generator.replace("-terraform", "")}-keyvalue</artifactId>
                    <version>${cloudhopper.version}</version>
                </dependency>
#end
## knative and scaleway-terraform run the springboot-http application: same dependencies, same executable jar
#if($generator == "springboot-http" || $generator == "knative" || $generator == "scaleway-terraform")
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-springboot</artifactId>
                    <version>${cloudhopper.version}</version>
                </dependency>
#if($generator == "knative" || $generator == "scaleway-terraform")
                <!-- reads and writes tables in PostgreSQL from function code (@Table KeyValueStore) -->
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-jdbc-keyvalue</artifactId>
                    <version>${cloudhopper.version}</version>
                </dependency>
#end
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-http</artifactId>
                    <version>${cloudhopper.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-webmvc</artifactId>
                    <version>${spring-boot.version}</version>
                </dependency>
#end
#if($generator == "knative")
                <!-- @Queue publishers send to the Kafka topics that the KafkaSources deliver -->
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-kafka</artifactId>
                    <version>${spring-boot.version}</version>
                </dependency>
#end
#if($generator == "scaleway-terraform")
                <!-- @Queue publishers send to Scaleway Queues through its SQS API -->
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-aws-publisher</artifactId>
                    <version>${cloudhopper.version}</version>
                    <exclusions>
                        <!-- only Lambda functions need these -->
                        <exclusion>
                            <groupId>com.amazonaws</groupId>
                            <artifactId>aws-lambda-java-core</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.amazonaws</groupId>
                            <artifactId>aws-lambda-java-events</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
#end
#if($generator == "knative" || $generator == "scaleway-terraform")
                <!-- reads and writes buckets from function code (@Bucket BlobStore) through the S3 API -->
                <dependency>
                    <groupId>eu.cloudhopper.mc</groupId>
                    <artifactId>provider-aws-blobstore</artifactId>
                    <version>${cloudhopper.version}</version>
                    <exclusions>
                        <!-- only Lambda functions need these -->
                        <exclusion>
                            <groupId>com.amazonaws</groupId>
                            <artifactId>aws-lambda-java-core</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.amazonaws</groupId>
                            <artifactId>aws-lambda-java-events</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
#end
#if($generator == "azure-terraform")
                <dependency>
                    <groupId>com.microsoft.azure.functions</groupId>
                    <artifactId>azure-functions-java-library</artifactId>
                    <version>3.1.0</version>
                </dependency>
#end
            </dependencies>
#if($generator == "springboot-http" || $generator == "knative" || $generator == "scaleway-terraform")
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>add-springboot-source</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/main/springboot-http</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- the executable jar next to the plain one, under the name the generated Dockerfile expects:
                         java -jar target/<artifactId>-<version>-<generator>.jar -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                                <configuration>
                                    <classifier>\${jar.classifier}</classifier>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
#if($generator == "scaleway-terraform")
                    <!-- Terraform runs in target/deployment/<generator>: the hand-written files from
                         src/main/resources/deployment/<generator> (provider, backend, variables) go next to the generated ones -->
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-terraform-files</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>\${project.build.directory}/deployment/\${generator.id}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/resources/deployment/\${generator.id}</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
#end
                </plugins>
            </build>
#end
#if($generator == "aws-terraform" || $generator == "gcp-terraform")
            <build>
                <plugins>
                    <!-- the function jar with all dependencies, under the name the generated Terraform uploads:
                         target/<artifactId>-<version>-<generator>.jar -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <shadedClassifierName>\${jar.classifier}</shadedClassifierName>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
#if($generator == "gcp-terraform")
                    <!-- Cloud Functions takes a zip: target/<artifactId>-<version>-gcp-terraform.zip with the jar inside -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>zip-function</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <zip destfile="\${project.build.directory}/\${project.artifactId}-\${project.version}-\${jar.classifier}.zip">
                                            <fileset file="\${project.build.directory}/\${project.artifactId}-\${project.version}-\${jar.classifier}.jar"/>
                                        </zip>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
#end
                    <!-- Terraform runs in target/deployment/<generator>: the hand-written files from
                         src/main/resources/deployment/<generator> (provider, backend, variables) go next to the generated ones -->
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-terraform-files</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>\${project.build.directory}/deployment/\${generator.id}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/resources/deployment/\${generator.id}</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
#end
#if($generator == "azure-terraform")
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.microsoft.azure</groupId>
                        <artifactId>azure-functions-maven-plugin</artifactId>
                        <version>1.24.0</version>
                        <configuration>
                            <appName>demo-function-app</appName>
                            <resourceGroup>demo-group</resourceGroup>
                            <appServicePlanName>demo-plan</appServicePlanName>
                            <region>westeurope</region>
                            <runtime>
                                <os>linux</os>
                                <javaVersion>11</javaVersion>
                            </runtime>
                            <appSettings>
                                <property>
                                    <name>FUNCTIONS_EXTENSION_VERSION</name>
                                    <value>~4</value>
                                </property>
                            </appSettings>
                            <skipInstallExtensions>true</skipInstallExtensions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>package-functions</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>package</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- the generated Terraform uploads target/<artifactId>-<version>-azure-terraform.zip:
                         the function app the plugin above staged -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>zip-function-app</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <zip destfile="\${project.build.directory}/\${project.artifactId}-\${project.version}-\${jar.classifier}.zip"
                                             basedir="\${project.build.directory}/azure-functions/demo-function-app"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Terraform runs in target/deployment/<generator>: the hand-written files from
                         src/main/resources/deployment/<generator> (provider, backend, variables) go next to the generated ones -->
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-terraform-files</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>\${project.build.directory}/deployment/\${generator.id}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/resources/deployment/\${generator.id}</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
#end
        </profile>
#end
#if($generatorIds.contains("springboot-http") || $generatorIds.contains("knative") || $generatorIds.contains("scaleway-terraform"))
        <!-- The Spring Boot application (springboot-http, knative, scaleway-terraform) as a native image,
             together with the target's profile, e.g. -Pknative,springboot-native: starts in well under a
             second and needs a fraction of the memory. Runs Spring AOT on the build; the generated
             Dockerfile then compiles the native image with GraalVM in its first stage (docker build). -->
        <profile>
            <id>springboot-native</id>
            <properties>
                <cloudhopper.runtime>native</cloudhopper.runtime>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
#end
#if($generatorIds.contains("aws-terraform"))
        <!-- aws-terraform as a native image on the Lambda custom runtime (provided.al2023), with
             -Paws-terraform,aws-native: shorter cold starts, less memory. Builds the executable
             bootstrap with GraalVM in a container (Docker; native images cannot be cross-compiled)
             for native.architecture, and packs it into target/<artifactId>-<version>-aws-terraform-native.zip,
             which the generated Terraform deploys. -->
        <profile>
            <id>aws-native</id>
            <properties>
                <cloudhopper.runtime>native</cloudhopper.runtime>
                <native.image>ghcr.io/graalvm/native-image-community:25.0.2</native.image>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <id>native-image</id>
                                <!-- after the shade plugin has built the jar in package -->
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>--rm</argument>
                                        <argument>--platform</argument>
                                        <argument>linux/\${native.architecture}</argument>
                                        <argument>-v</argument>
                                        <argument>\${project.build.directory}:/work</argument>
                                        <argument>\${native.image}</argument>
                                        <argument>--no-fallback</argument>
                                        <argument>-cp</argument>
                                        <argument>/work/\${project.artifactId}-\${project.version}-aws-terraform.jar</argument>
                                        <argument>-o</argument>
                                        <argument>/work/bootstrap</argument>
                                        <argument>eu.cloudhopper.mc.provider.aws.NativeRuntime</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.1</version>
                        <executions>
                            <execution>
                                <id>native-zip</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <finalName>\${project.artifactId}-\${project.version}-aws-terraform</finalName>
                                    <appendAssemblyId>true</appendAssemblyId>
                                    <attach>false</attach>
                                    <inlineDescriptors>
                                        <inlineDescriptor>
                                            <id>native</id>
                                            <formats>
                                                <format>zip</format>
                                            </formats>
                                            <includeBaseDirectory>false</includeBaseDirectory>
                                            <files>
                                                <file>
                                                    <source>\${project.build.directory}/bootstrap</source>
                                                    <fileMode>0755</fileMode>
                                                </file>
                                            </files>
                                        </inlineDescriptor>
                                    </inlineDescriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
#end
#if($includeTerraformProfile == "true")
        <profile>
            <id>deploy-with-terraform</id>
            <activation>
                <activeByDefault>false</activeByDefault> 
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>terraform-init</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${terraform.executable}</executable>
                                    <workingDirectory>${project.build.directory}/deployment/${generator.id}</workingDirectory>
                                    <arguments>
                                        <argument>init</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <PATH>${path.extras}:${env.PATH}</PATH>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                            <execution>
                                <id>terraform-command</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${terraform.executable}</executable>
                                    <workingDirectory>${project.build.directory}/deployment/${generator.id}</workingDirectory>
                                    <arguments>
                                        <argument>\${terraform.command}</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <PATH>${path.extras}:${env.PATH}</PATH>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
#end
    </profiles>

</project>
