# Generated by Cloudhopper (gcp-terraform); do not edit.
# The buckets functions read and write (@Bucket), and the permissions of their identities.
locals {
  # @Bucket names mapped to buckets your own Terraform creates, e.g.
  # { reports = google_storage_bucket.reports.name }; redefine this local in an override file
  # (cloudhopper_override.tf). The generated Terraform creates no bucket for these names.
  cloudhopper_bucket_names = {}
}
<#list buckets as b>
<#assign id = b.id>

<#if b.existing>
# @Bucket(name = "${b.name}", existing = true): a bucket another system owns
locals {
  cloudhopper_bucket_${id} = "${b.name}"
}
<#elseif storageBuckets[b.name]??>
<#assign fid = storageBuckets[b.name]>
# @Bucket(name = "${b.name}"): the bucket of the storage trigger of function ${fid}
locals {
  cloudhopper_bucket_${id} = <#if storageBucketCreated[b.name]>google_storage_bucket<#else>data.google_storage_bucket</#if>.${fid}_bucket.name
}
<#else>
# @Bucket(name = "${b.name}"), unless cloudhopper_bucket_names names a bucket of your own. Cloud
# Storage bucket names are global across all projects. Terraform does not delete a bucket that
# still contains objects.
resource "google_storage_bucket" "bucket_${id}" {
  count                       = contains(keys(local.cloudhopper_bucket_names), "${b.name}") ? 0 : 1
  name                        = "${b.name}"
  location                    = var.gcp_region
  uniform_bucket_level_access = true
}

locals {
  cloudhopper_bucket_${id} = lookup(local.cloudhopper_bucket_names, "${b.name}", one(google_storage_bucket.bucket_${id}[*].name))
}
</#if>

output "bucket_${id}" {
  value = local.cloudhopper_bucket_${id}
}
<#list bucketAccess[b.name] as identity, access>

# ${access} access of identity "${identity}" to bucket "${b.name}"<#if access == "WRITE">; Cloud Storage
# has no predefined role that writes without reading, the runtime refuses reads that the
# parameter does not declare</#if>
resource "google_storage_bucket_iam_member" "bucket_${id}_${identity}" {
  bucket = local.cloudhopper_bucket_${id}
  role   = "<#if access == "READ">roles/storage.objectViewer<#else>roles/storage.objectUser</#if>"
  member = google_service_account.identity_${identity}.member
}
</#list>
</#list>
