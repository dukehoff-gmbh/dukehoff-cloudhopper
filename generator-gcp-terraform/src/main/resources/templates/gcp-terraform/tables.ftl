# Generated by Cloudhopper (gcp-terraform); do not edit.
# The tables functions read and write (@Table): one Firestore database (Native mode) per table,
# and the permissions of their identities.
locals {
  # @Table names mapped to Firestore databases your own Terraform creates, e.g.
  # { accounts = google_firestore_database.accounts.name }; redefine this local in an override
  # file (cloudhopper_override.tf). The generated Terraform creates no database for these names.
  cloudhopper_table_names = {}
}
<#if tables?has_content>

data "google_client_config" "cloudhopper_tables" {}
</#if>
<#list tables as t>
<#assign id = t.id>

<#if t.existing>
# @Table(name = "${t.name}", existing = true): a Firestore database another system owns
locals {
  cloudhopper_table_${id} = "${t.name}"
}
<#else>
# @Table(name = "${t.name}"), unless cloudhopper_table_names names a database of your own. The
# database's ID is the project name and the table name with a random suffix: Firestore keeps the
# ID of a deleted database for a few minutes, so a deployment created again right after a destroy
# gets a new one. Destroying the deployment deletes the database and its items.
resource "random_id" "table_${id}" {
  count       = contains(keys(local.cloudhopper_table_names), "${t.name}") ? 0 : 1
  byte_length = 3
}

resource "google_firestore_database" "table_${id}" {
  count                   = contains(keys(local.cloudhopper_table_names), "${t.name}") ? 0 : 1
  name                    = "${"$"}{trim(substr(trim(replace(lower("${"$"}{var.project_name}-${t.name}"), "/[^a-z0-9-]/", "-"), "-"), 0, 56), "-")}-${"$"}{random_id.table_${id}[0].hex}"
  location_id             = var.gcp_region
  type                    = "FIRESTORE_NATIVE"
  delete_protection_state = "DELETE_PROTECTION_DISABLED"
  deletion_policy         = "DELETE"
}

locals {
  cloudhopper_table_${id} = lookup(local.cloudhopper_table_names, "${t.name}", one(google_firestore_database.table_${id}[*].name))
}
</#if>

output "table_${id}" {
  value = local.cloudhopper_table_${id}
}
<#list tableAccess[t.name] as identity, access>

# ${access} access of identity "${identity}" to table "${t.name}", limited to its database<#if access == "WRITE">;
# Firestore has no predefined role that writes without reading, the runtime refuses reads that
# the parameter does not declare</#if>
resource "google_project_iam_member" "table_${id}_${identity}" {
  project = data.google_client_config.cloudhopper_tables.project
  role    = "<#if access == "READ">roles/datastore.viewer<#else>roles/datastore.user</#if>"
  member  = google_service_account.identity_${identity}.member

  condition {
    title      = "cloudhopper-table-${t.name}"
    expression = "resource.name == \"projects/${"$"}{data.google_client_config.cloudhopper_tables.project}/databases/${"$"}{local.cloudhopper_table_${id}}\""
  }
}
</#list>
</#list>
