# Generated by Cloudhopper (gcp-terraform); do not edit.
# Permission of the identities that send with @Queue to publish to the queues' topics.
<#list queuePublishers as queue, identities>
<#assign qid = queue?lower_case?replace("[^a-z0-9_]", "_", "r")>
<#if queueConsumers[queue]?? && !(publishedQueues?filter(q -> q.name == queue && q.existing)?has_content)>
<#assign fid = queueConsumers[queue]>
<#assign topic = (queueCreated[queue]!true)?then("google_pubsub_topic.${fid}_topic.id", "data.google_pubsub_topic.${fid}_topic.id")>
<#else>
<#assign topic = "\"projects/${r'${var.gcp_project_id}'}/topics/${queue}\"">
</#if>
<#list identities as identity>
resource "google_pubsub_topic_iam_member" "publish_${qid}_${identity}" {
  topic  = ${topic}
  role   = "roles/pubsub.publisher"
  member = google_service_account.identity_${identity}.member
}

</#list>
</#list>
